-- 事实源头这个盒子：运行、运行项、运行项的结束与运行的停机锚点。
-- 只写每个端口在数据上的前后条件；端口之间的先后由 design/behavior 持有。
-- 精度停在“事实只写一次、按序写下”：记录的内容（输入、产出、现场）保持不透明。
module soroi_store
exports
  types
    RunId; RuntimeId; struct Outcome; Trigger
  operations
    writeRun : RunId ==> ();
    writeStart : RunId ==> RuntimeId;
    writeEnd : RuntimeId * Outcome ==> ();
    writeHalt : RunId * Trigger ==> ()
definitions
types
  RunId = token;
  RuntimeId = token;
  -- 结束的内容保持不透明，只区分是否由停机结束。
  Outcome = <Settled> | <Halted>;
  Trigger = token;

state Records of
  runs     : set of RunId
  runtimes : map RuntimeId to RunId
  ends     : map RuntimeId to Outcome
  halts    : map RunId to Trigger
inv mk_Records(rs, rts, es, hs) ==
  rng rts subset rs and dom es subset dom rts and dom hs subset rs
init s == s = mk_Records({}, {|->}, {|->}, {|->})
end

operations
  writeRun(r : RunId)
  ext wr runs
  pre r not in set runs
  post runs = runs~ union {r};

  -- 已写下 halt 的运行不再得到新的运行项；新运行项的身份是新的。
  writeStart(r : RunId) res : RuntimeId
  ext rd runs, halts
      wr runtimes
  pre r in set runs and r not in set dom halts
  post res not in set dom runtimes~ and runtimes = runtimes~ munion {res |-> r};

  -- REQ-34：一个运行项的结束至多写下一次。
  writeEnd(rt : RuntimeId, o : Outcome)
  ext rd runtimes
      wr ends
  pre rt in set dom runtimes and rt not in set dom ends
  post ends = ends~ munion {rt |-> o};

  -- REQ-57：运行的停机锚点只在它的全部运行项都有结束之后写下，且只写一次。
  writeHalt(r : RunId, t : Trigger)
  ext rd runs, runtimes, ends
      wr halts
  pre r in set runs and r not in set dom halts and
      forall rt in set dom runtimes & runtimes(rt) = r => rt in set dom ends
  post halts = halts~ munion {r |-> t};

end soroi_store

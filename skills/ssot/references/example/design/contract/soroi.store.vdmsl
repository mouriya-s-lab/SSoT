-- 事实源头的记录契约：运行、运行项、事实追加、结束发布、停机锚点、引用读取与回放读取。
-- 本模块只写每次读写在数据上的前后条件；这些读写的先后由 design/behavior 持有。
module soroi_store
imports
  from soroi
    types RunId; RuntimeId; Path; Digest; Snapshot; Parsed
exports
  types
    struct Position; struct BundleDigest; struct Time;
    struct AttrName; struct OutputName; struct Byte; struct ToolName; struct CallId;
    struct ValueSource; struct BoundKind; struct Bound; struct Sourced;
    struct ControlKind; struct ControlSource; struct InputRecord;
    struct ToolRecord; struct RejectKind; struct RejectReason; struct CallRejected; struct SlotWrite; struct Fact;
    struct ListValue; struct FileRef; struct CapturedValue; struct Captured;
    struct VerifyRule; struct VerifyFault; struct ThrownFault; struct RuntimeReason;
    struct Out; struct Thrown; struct RuntimeFault; struct Outcome; struct End;
    struct Start; struct Own; struct RefEntry; struct Entry;
    struct Edit; struct DerivationId; struct Derived; struct RunRecord; struct Trigger;
    struct Published; struct PublishedEnd; struct StartFailed;
    struct Interval; struct Aligned;
  functions
    byteLess : OutputName * OutputName -> bool
  operations
    writeBundle : BundleDigest ==> ();
    writeRun : soroi`RunId * RunRecord ==> ();
    writeStart : soroi`RunId * Start ==> soroi`RuntimeId | StartFailed;
    readStart : soroi`RuntimeId ==> Start;
    appendBucket : soroi`RuntimeId * Fact ==> ();
    writeEnd : soroi`RuntimeId * End ==> ();
    writeHalt : soroi`RunId * Trigger ==> ();
    appendRef : soroi`RunId * soroi`RuntimeId ==> soroi`RuntimeId;
    readActivation : soroi`RuntimeId * BundleDigest ==> Own;
    replay : soroi`RuntimeId ==> Published;
    timeline : soroi`RunId ==> seq of Interval;
    compare : soroi`RunId * soroi`RunId ==> map Position to Aligned
definitions
types
  -- 工作流中的语义位置：同一 run 内一个节点激活的位置。
  Position = token;
  BundleDigest = token;
  -- 发布时刻的记录值；本设计不建模时钟。
  Time = nat;
  AttrName = seq of char
  inv a == a <> [];
  Byte = nat
  inv b == b <= 255;
  -- REQ-28：产出名按字节序排列。
  OutputName = seq of Byte
  inv n == n <> [];
  ToolName = seq of char
  inv t == t <> [];
  CallId = token;

  -- REQ-5：输入属性的值来源只有任务输入、Bind 的源值（普通产出或被接住的异常）和介入编辑值。
  ValueSource = <TaskInput> | <Edit> | Bound;
  BoundKind = <Produced> | <Caught>;
  Bound ::
    at   : Position
    kind : BoundKind;
  -- REQ-5：每个输入属性都有一个 Present 的值：值的类型就是解析过的业务值，没有缺席分支。
  Sourced ::
    value  : soroi`Parsed
    source : ValueSource;
  -- REQ-48：Judge 与 Continue 传递容器控制，同样带位置。
  ControlKind = <Judge> | <Continue>;
  ControlSource ::
    kind : ControlKind
    at   : Position;
  InputRecord ::
    attrs    : map AttrName to Sourced
    controls : set of ControlSource;

  -- REQ-13/REQ-15/REQ-33：bucket 中的已观察事实。
  ToolRecord ::
    call  : CallId
    tool  : ToolName
    seqNo : nat1
    value : soroi`Parsed;
  -- REQ-15：拒绝带原因的种类与诊断文本。
  RejectKind = <Infra> | <Invalid>;
  RejectReason ::
    kind    : RejectKind
    message : seq of char;
  -- 带 call 的拒绝依据工具的结束事实；不带 call 的拒绝由闭包入口自己判定。
  CallRejected ::
    call   : [CallId]
    reason : RejectReason;
  SlotWrite ::
    value : soroi`Parsed;
  Fact = ToolRecord | CallRejected | SlotWrite;

  ListValue ::
    items : seq1 of soroi`Parsed;
  FileRef ::
    path   : soroi`Path
    digest : soroi`Digest;
  -- REQ-30：没有对应工具记录时为 AbsentCapture，不伪造值。
  CapturedValue = soroi`Parsed | ListValue | FileRef | <AbsentCapture>;
  Captured ::
    name  : OutputName
    value : CapturedValue;

  VerifyRule = <Required> | soroi`Path;
  VerifyFault ::
    output : OutputName
    rule   : VerifyRule;
  ThrownFault ::
    label : seq of char;
  RuntimeReason = <Body> | VerifyFault | ThrownFault | <Exec>;

  -- REQ-39：Out 只含 captured，现场不在产出里。
  -- REQ-28：captured 按 OutputName 字节序排列。
  Out ::
    captured : seq of Captured
  inv o == forall i, j in set inds o.captured & i < j => byteLess(o.captured(i).name, o.captured(j).name);
  Thrown ::
    label   : seq of char
    payload : soroi`Parsed;
  RuntimeFault ::
    reason : RuntimeReason;
  Outcome = Out | Thrown | RuntimeFault | <Halted>;

  -- REQ-34：结束时间、Outcome 与 Snapshot 在同一条结束记录里，一次发布。
  End ::
    at       : Time
    outcome  : Outcome
    snapshot : soroi`Snapshot;

  -- REQ-5：开始事实带节点 preset 的 [inputs] 声明；每个声明的输入属性都恰有一个 Present 来源。
  -- REQ-40：开始事实里有开始时刻与渲染文本，回放与时间轴只读它们。
  Start ::
    position : Position
    declared : set of AttrName
    input    : InputRecord
    at       : Time
    rendered : seq of char
  inv s == dom s.input.attrs = s.declared;
  Own ::
    start   : Start
    buckets : seq of Fact
    fin     : [End];
  RefEntry ::
    source : soroi`RuntimeId;
  Entry = Own | RefEntry;

  Edit ::
    at    : soroi`RuntimeId
    attr  : AttrName
    value : soroi`Parsed;
  DerivationId = token;
  Derived ::
    id     : DerivationId
    source : soroi`RunId
    edits  : seq of Edit;
  RunRecord ::
    bundle      : BundleDigest
    task        : token
    workflow    : token
    inputs      : map AttrName to soroi`Parsed
    workspace   : token
    harness     : token
    startedAt   : Time
    parallel    : nat1
    derivedFrom : [Derived];

  Trigger = <Manual> | <DaemonLost> | <Uncaught>;

  -- REQ-40：回放只读已发布的事实；没有结束记录的原样显示为 Open。
  Published ::
    start   : Start
    buckets : seq of Fact
    fin     : PublishedEnd;
  PublishedEnd = End | <Open>;

  StartFailed = <StartFailed>;

  -- REQ-40：时间轴上的一个区间。
  Interval ::
    position : Position
    runtime  : soroi`RuntimeId
    startAt  : Time
    endAt    : [Time];
  -- REQ-40：两个运行在同一语义位置上的运行项。
  Aligned ::
    left  : [soroi`RuntimeId]
    right : [soroi`RuntimeId];

state Records of
  bundles  : set of BundleDigest
  runs     : map soroi`RunId to RunRecord
  runtimes : map soroi`RuntimeId to Entry
  order    : map soroi`RunId to seq of soroi`RuntimeId
  halts    : map soroi`RunId to Trigger
inv mk_Records(-, rs, rts, os, hs) ==
  dom os = dom rs and
  dom hs subset dom rs and
  (forall r in set dom os & elems os(r) subset dom rts and len os(r) = card elems os(r)) and
  (forall r1, r2 in set dom os & r1 <> r2 => elems os(r1) inter elems os(r2) = {}) and
  (forall rt in set dom rts & exists r in set dom os & rt in set elems os(r))
init s == s = mk_Records({}, {|->}, {|->}, {|->}, {|->})
end

functions
  byteLess : OutputName * OutputName -> bool
  byteLess(a, b) ==
    if len a = 1 or len b = 1 then
      (hd a < hd b) or (hd a = hd b and len a < len b)
    else if hd a = hd b then byteLess(tl a, tl b)
    else hd a < hd b
  post RESULT <=>
    ((len a < len b and forall i in set inds a & a(i) = b(i)) or
     (exists k in set inds a inter inds b & a(k) < b(k) and forall i in set inds a & i < k => a(i) = b(i)))
  measure len a;

  runOf : soroi`RuntimeId * map soroi`RunId to seq of soroi`RuntimeId -> soroi`RunId
  runOf(rt, os) == let r in set dom os be st rt in set elems os(r) in r
  pre exists r in set dom os & rt in set elems os(r);

  ended : Entry -> bool
  ended(e) == is_RefEntry(e) or e.fin <> nil;

  -- REQ-37：可引用的源记录：Own、同一 bundle、有非 Halted 的结束记录。
  referable : soroi`RuntimeId * BundleDigest * map soroi`RunId to RunRecord *
              map soroi`RuntimeId to Entry * map soroi`RunId to seq of soroi`RuntimeId -> bool
  referable(src, b, rs, rts, os) ==
    src in set dom rts and is_Own(rts(src)) and
    (exists r in set dom os & src in set elems os(r)) and
    rs(runOf(src, os)).bundle = b and
    rts(src).fin <> nil and rts(src).fin.outcome <> <Halted>;

  -- 运行项所在的语义位置：Own 取它自己的开始事实，Ref 取它的源记录（源一定是 Own）。
  positioned : soroi`RuntimeId * map soroi`RuntimeId to Entry -> bool
  positioned(rt, rts) ==
    rt in set dom rts and
    (is_Own(rts(rt)) or (rts(rt).source in set dom rts and is_Own(rts(rts(rt).source))));

  positionOf : soroi`RuntimeId * map soroi`RuntimeId to Entry -> Position
  positionOf(rt, rts) ==
    if is_Own(rts(rt)) then rts(rt).start.position else rts(rts(rt).source).start.position
  pre positioned(rt, rts);

  entryAt : soroi`RunId * Position * map soroi`RuntimeId to Entry * map soroi`RunId to seq of soroi`RuntimeId
       -> [soroi`RuntimeId]
  entryAt(r, p, rts, os) ==
    if exists rt in set elems os(r) & positionOf(rt, rts) = p
    then let rt in set elems os(r) be st positionOf(rt, rts) = p in rt
    else nil
  pre r in set dom os and forall rt in set elems os(r) & positioned(rt, rts);

operations
  -- REQ-44：运行引用的 bundle 先单独发布。
  writeBundle(b : BundleDigest)
  ext wr bundles
  post bundles = bundles~ union {b};

  -- REQ-44：起运行与派生都以新的 RunId 发布完整 RunRecord，它的 bundle 已经发布；已有 RunRecord 不变。
  writeRun(r : soroi`RunId, rec : RunRecord)
  ext rd bundles
      wr runs, order
  pre r not in set dom runs and rec.bundle in set bundles
  post runs = runs~ munion {r |-> rec} and order = order~ munion {r |-> []};

  -- REQ-54：只有尚未写下 halt 的运行才可能得到新的运行项；返回 StartFailed 时没有运行项。
  writeStart(r : soroi`RunId, s : Start) res : soroi`RuntimeId | StartFailed
  ext rd runs, halts
      wr runtimes, order
  pre r in set dom runs and r not in set dom halts
  post (res = <StartFailed> and runtimes = runtimes~ and order = order~) or
       (res <> <StartFailed> and res not in set dom runtimes~ and
        runtimes = runtimes~ munion {res |-> mk_Own(s, [], nil)} and
        order = order~ ++ {r |-> order~(r) ^ [res]});

  -- REQ-60：闭包过程按自己的运行项直接取得开始事实中的输入，不经调度器转交。
  readStart(rt : soroi`RuntimeId) s : Start
  ext rd runtimes
  pre rt in set dom runtimes and is_Own(runtimes(rt))
  post s = runtimes(rt).start;

  -- REQ-33：只向仍无 end 的 Own 运行项追加一条已观察事实。
  appendBucket(rt : soroi`RuntimeId, f : Fact)
  ext wr runtimes
  pre rt in set dom runtimes and is_Own(runtimes(rt)) and runtimes(rt).fin = nil
  post runtimes = runtimes~ ++ {rt |-> mu(runtimes~(rt), buckets |-> runtimes~(rt).buckets ^ [f])};

  -- REQ-34：结束时间、Outcome 与 Snapshot 一次发布；一个运行项至多成功一次。
  writeEnd(rt : soroi`RuntimeId, e : End)
  ext wr runtimes
  pre rt in set dom runtimes and is_Own(runtimes(rt)) and runtimes(rt).fin = nil
  post runtimes = runtimes~ ++ {rt |-> mu(runtimes~(rt), fin |-> e)};

  -- REQ-55/REQ-57：运行的结束锚点只在它的全部运行项都有 end 之后写下，且只写一次。
  writeHalt(r : soroi`RunId, t : Trigger)
  ext rd runs, runtimes, order
      wr halts
  pre r in set dom runs and r not in set dom halts and
      forall rt in set elems order(r) & ended(runtimes(rt))
  post halts = halts~ munion {r |-> t};

  -- REQ-49：派生运行为每个沿用位置追加 Ref；被引用的源必须可引用。
  appendRef(r : soroi`RunId, src : soroi`RuntimeId) rt : soroi`RuntimeId
  ext rd runs, halts
      wr runtimes, order
  pre r in set dom runs and r not in set dom halts and
      referable(src, runs(r).bundle, runs, runtimes, order)
  post rt not in set dom runtimes~ and
       runtimes = runtimes~ munion {rt |-> mk_RefEntry(src)} and
       order = order~ ++ {r |-> order~(r) ^ [rt]};

  -- REQ-37：读取 source 一次，不执行旧运行项，不修改任何运行；source 必须可引用（校验写在 pre）。
  --        派生只读取沿用分区里的旧记录，它们按定义都可引用（REQ-49），所以没有拒绝的结局。
  readActivation(src : soroi`RuntimeId, b : BundleDigest) res : Own
  ext rd runs, runtimes, order
  pre referable(src, b, runs, runtimes, order)
  post res = runtimes(src);

  -- REQ-40：回放读取已发布的输入、渲染文本、bucket、结果与现场；没有结束记录时为 Open，不作推断。
  replay(rt : soroi`RuntimeId) p : Published
  ext rd runtimes
  pre rt in set dom runtimes and is_Own(runtimes(rt))
  post p = mk_Published(runtimes(rt).start, runtimes(rt).buckets,
                        if runtimes(rt).fin = nil then <Open> else runtimes(rt).fin);

  -- REQ-40：时间轴只把运行项的开始、结束和位置投影成区间；没有结束记录的区间没有终点。
  timeline(r : soroi`RunId) iv : seq of Interval
  ext rd runtimes, order
  pre r in set dom order
  post iv = [mk_Interval(runtimes(rt).start.position, rt, runtimes(rt).start.at,
                         if runtimes(rt).fin = nil then nil else runtimes(rt).fin.at)
             | rt in seq order(r) & is_Own(runtimes(rt))];

  -- REQ-40：对比按语义位置对齐两个运行；Ref 取它的源记录所在的位置。
  compare(left : soroi`RunId, right : soroi`RunId) al : map Position to Aligned
  ext rd runtimes, order
  pre left in set dom order and right in set dom order and
      (forall rt in set elems order(left) union elems order(right) & positioned(rt, runtimes))
  post al = {p |-> mk_Aligned(entryAt(left, p, runtimes, order), entryAt(right, p, runtimes, order))
             | p in set {positionOf(rt, runtimes) | rt in set elems order(left) union elems order(right)}};

end soroi_store

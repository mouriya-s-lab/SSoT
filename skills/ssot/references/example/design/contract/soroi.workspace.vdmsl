-- 执行边界这个盒子（REQ-19）：由实现者注入，为每个运行项维持一个闭包，接纳并终止闭包里的执行。
-- 只写每个端口在数据上的前后条件；关闭与在途 launch 的先后由 design/behavior 持有。
-- 精度停在“关闭与接纳互斥”：注入、取回的内容、现场、配置与执行边界自身的失败不在这里展开。
module soroi_workspace
imports
  from soroi_store
    types RuntimeId
exports
  types
    ExecRef; struct Rejected
  operations
    open : soroi_store`RuntimeId ==> ();
    launch : soroi_store`RuntimeId * ExecRef ==> ExecRef | Rejected;
    collect : soroi_store`RuntimeId * ExecRef ==> ();
    close : soroi_store`RuntimeId ==> ()
definitions
types
  ExecRef = token;
  Rejected = <Rejected>;

-- 一个运行项的闭包是否打开、是否已记下关闭，以及被接纳、尚未终止的执行属于哪个运行项。
state Closures of
  opened  : set of soroi_store`RuntimeId
  closed  : set of soroi_store`RuntimeId
  running : map ExecRef to soroi_store`RuntimeId
inv mk_Closures(os, cs, rn) ==
  cs subset os and rng rn subset os \ cs
init s == s = mk_Closures({}, {}, {|->})
end

operations
  -- REQ-23：同一运行项的 open 幂等，闭包已关闭时也一样。
  open(rt : soroi_store`RuntimeId)
  ext wr opened
  post opened = opened~ union {rt};

  -- REQ-24：关闭记下之后拒绝该运行项的 launch；被接纳的执行记入 running。
  launch(rt : soroi_store`RuntimeId, x : ExecRef) r : ExecRef | Rejected
  ext rd opened, closed
      wr running
  pre rt in set opened and x not in set dom running
  post (rt in set closed => r = <Rejected>) and
       ((r = x and running = running~ munion {x |-> rt}) or
        (r = <Rejected> and running = running~));

  -- 一次性取回执行的结束；取回后它不再在 running 里。结束的内容在这一精度下不展开。
  collect(rt : soroi_store`RuntimeId, x : ExecRef)
  ext wr running
  pre x in set dom running and running(x) = rt
  post running = {x} <-: running~;

  -- REQ-24：close 返回即该运行项下被接纳的全部执行都已终止；再次 close 照样成功。
  close(rt : soroi_store`RuntimeId)
  ext rd opened
      wr closed, running
  pre rt in set opened
  post closed = closed~ union {rt} and running = running~ :-> {rt};

end soroi_workspace

specification {
  element actor {
    notation 'Person'
    style {
      shape person
    }
  }
  element system {
    notation 'Software System'
  }
  element container {
    notation 'Container'
  }
  element component {
    notation 'Component'
  }

  tag external
  tag datastore
  tag contract
  tag untrusted

  deploymentNode host
}

model {
  caller = actor 'Caller' {
    description '启动、停止与派生运行，并读取运行事实的使用方'
  }

  soroi = system 'soroi' {
    description '管理工作流运行、协调执行并记录运行事实的核心'

    engine = container 'Engine' {
      technology 'Daemon process'
      description '受理运行请求，推进并收束运行'

      control = component 'Control' {
        description '使用方与引擎之间唯一的操作面'
      }
      scheduler = component 'Scheduler' {
        description '准入运行项并判定运行是否自然完成'
      }
      halting = component 'Halting' {
        description '收束一次运行并写下它的结束'
      }
      closure = component 'Closure' {
        description '负责一个运行项从准入到结束的全部生命周期'
      }
      derivation = component 'Derivation' {
        description '基于既有运行的事实派生新运行'
      }
      values = component 'Values' {
        description '把原始文本按声明的结构解析成业务值的唯一入口'
      }
    }

    store = container 'Store' {
      #datastore #contract
      technology 'Persistent store'
      description '运行事实的唯一源头'
    }

    workspace = container 'Workspace' {
      #contract
      technology 'Execution service, implementer-provided'
      description '承载执行方运行的执行边界，由实现者注入'
    }
  }

  preset = system 'Preset' {
    #external
    description '执行工作流里具体工作的 agent 与作者程序'
  }

  // 顶层
  caller -> soroi '管理运行并读取运行事实'
  soroi -> preset '运行具体工作'
  preset -> soroi '提交工具调用与返回结果'

  // soroi 容器层
  caller -> soroi.engine '管理运行'
  caller -> soroi.store '读取运行事实'
  soroi.engine -> soroi.store '读写运行事实'
  soroi.engine -> soroi.workspace '在执行边界内执行运行项'
  soroi.workspace -> soroi.engine '转交执行方的调用与结果'
  soroi.workspace -> preset '运行 agent 与作者程序'
  preset -> soroi.workspace '提交工具调用与返回结果'

  // engine 组件层
  caller -> soroi.engine.control '提交启动、停止与派生请求'
  soroi.engine.control -> soroi.engine.values '解析任务输入'
  soroi.engine.control -> soroi.engine.scheduler '交出新运行'
  soroi.engine.control -> soroi.engine.halting '停下运行'
  soroi.engine.control -> soroi.engine.derivation '派生新运行'
  soroi.engine.control -> soroi.store '发布新运行'
  soroi.engine.scheduler -> soroi.engine.closure '交出准入的运行项'
  soroi.engine.scheduler -> soroi.store '读取运行事实并登记运行项'
  soroi.engine.halting -> soroi.engine.scheduler '停止准入'
  soroi.engine.halting -> soroi.engine.closure '收束未结束的运行项'
  soroi.engine.halting -> soroi.store '写下运行的结束'
  soroi.engine.derivation -> soroi.engine.halting '停下源运行'
  soroi.engine.derivation -> soroi.engine.values '解析编辑值'
  soroi.engine.derivation -> soroi.store '读取源运行并发布派生运行'
  soroi.engine.closure -> soroi.engine.values '解析执行方交回的值'
  soroi.engine.closure -> soroi.store '读取输入并写入运行项事实'
  soroi.engine.closure -> soroi.workspace '在执行边界内执行并关闭运行项'
  soroi.workspace -> soroi.engine.closure '转交执行方的调用与结果'
}

deployment {
  host daemonHost 'Daemon host' {
    description '运行 soroi 守护进程与事实源头的主机'
    instanceOf soroi.engine
    instanceOf soroi.store
  }
  host execEnv 'Execution environment' {
    #untrusted
    description '实现者提供的执行环境，与核心分属不同的信任边界'
    instanceOf soroi.workspace
    instanceOf preset
  }
}

global {
  styleGroup theme {
    style element.tag = #external {
      color muted
      notation 'External Software System'
    }
    style element.tag = #datastore {
      shape storage
      notation 'Container: Data Store'
    }
  }
}

views {
  global style theme

  view index {
    title 'soroi 系统上下文'
    description 'soroi 为谁服务，又调用哪些外部系统'
    include *
  }

  view soroiView of soroi {
    title 'soroi 容器图'
    description 'soroi 由哪些运行单元组成，它们之间以及与外部怎样调用'
    include *
  }

  view engineView of soroi.engine {
    title 'Engine 组件图'
    description 'Engine 内部由哪些功能块组成，它们之间以及与外部怎样调用'
    include *
  }

  deployment view deployed {
    title 'soroi 部署图'
    description 'soroi 的容器运行在哪些主机上，信任边界在哪里'
    include daemonHost.**
    include execEnv.**
    exclude * -> * where source.kind is component or target.kind is component
    style daemonHost.engine {
      notation 'Container'
    }
    style execEnv.workspace {
      notation 'Container'
    }
    style daemonHost.store {
      shape storage
      notation 'Container: Data Store'
    }
    style execEnv.preset {
      color muted
      notation 'External Software System'
    }
    style execEnv {
      color red
      notation 'Untrusted execution environment'
    }
  }
}

-- 下单的请求与回复。
module shop_api
imports
  from shop_ledger types OrderId renamed OrderId
exports
  types struct Reply
  operations
    place : OrderId * nat ==> Reply
definitions
types
  Reply = <Accepted> | <Rejected>;
operations
  place(o : OrderId, amount : nat) r : Reply
  pre amount > 0
  post true;
end shop_api

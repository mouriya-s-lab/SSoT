specification {
  element actor { notation 'Person' style { shape person } }
  element system { notation 'Software System' }
  element container { notation 'Container' }
  element store { notation 'Container: Data Store' style { shape storage } }
  element component { notation 'Component' }
  deploymentNode host
  tag contract
  tag business
  tag external
}

model {
  user = actor 'User'

  shop = system 'Shop' {
    description '下单与记账'

    api = container 'API' {
      #business #contract
      description '受理订单'
      technology 'HTTP'
      metadata {
        group 'Applications'
      }
    }
    reports = container 'Reports' {
      description '汇总订单报表'
      technology 'Job process'
      metadata {
        group 'Applications'
      }
    }
    ledger = container 'Ledger' {
      #contract
      description '订单的记账事实'
      technology 'Database'
      style { shape storage }
    }
    api -> ledger '记下订单金额'
  }

  user -> shop.api '下单'
}

deployment {
  host coreNet 'Core network' {
    description '运行 API 与账本数据库的核心内网'
    instanceOf shop.api
    instanceOf shop.ledger
  }
}

views {
  view index {
    include *
  }
  view shopLayer of shop {
    include *
  }
  deployment view deployed {
    include coreNet.**
  }
}

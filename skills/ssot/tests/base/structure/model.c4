specification {
  element actor { notation 'Person' style { shape person } }
  element system { notation 'Software System' }
  element container { notation 'Container' }
  element component { notation 'Component' }
  tag contract
  tag business
}

model {
  user = actor 'User'

  shop = system 'Shop' {
    description '下单与记账'

    api = container 'API' {
      #business #contract
      description '受理订单'
      technology 'HTTP'
    }
    ledger = container 'Ledger' {
      #contract
      description '订单的记账事实'
      technology 'Database'
      style { shape storage }
    }
    api -> ledger '记下订单金额'
  }

  user -> shop.api '下单'
}

views {
  view index {
    include *
  }
  view shopLayer of shop {
    include *
  }
}
